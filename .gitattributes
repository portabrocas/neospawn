# Keep line endings identical on every OS (macOS, Linux, Windows), so checkouts and
# regenerated files never show up as changed just because of CRLF vs LF.
* text=auto eol=lf

# Windows scripts need CRLF or cmd.exe can misread them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.jar binary
*.nbt binary
*.ogg binary
*.zip binary
